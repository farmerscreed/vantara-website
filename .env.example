# Formspree form ID — the part after `/f/` in your endpoint URL.
# Create a form at https://formspree.io/ pointing to info@vantarainternational.com
# and paste the ID here (and in Vercel project settings).
NEXT_PUBLIC_FORMSPREE_ID=

# Flip to "true" once public/videos/hero-video.mp4 is available.
NEXT_PUBLIC_USE_HERO_VIDEO=false
